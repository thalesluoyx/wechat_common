# Data directory & Sensitive configs (Rule C)
# 忽略所有真实密钥配置与运行时数据，保留目录结构与脱敏样例
data/*
!data/wecom_config.example.json
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep

